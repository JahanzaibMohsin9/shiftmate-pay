# keystore.properties — DO NOT COMMIT THIS FILE
# Copy this template and fill in your values after generating a keystore.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore shiftmate-pay-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias shiftmate
#
# Then fill in the values below and place this file at android/keystore.properties

storeFile=../shiftmate-pay-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=shiftmate
keyPassword=YOUR_KEY_PASSWORD
